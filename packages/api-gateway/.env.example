API_PORT=3060
API_HOST=0.0.0.0

# 数据存储：不设置则使用内存库（重启丢数据）；设置后启用 PostgreSQL（需先 pnpm db:generate && pnpm db:migrate）
# DATABASE_URL="postgresql://user:password@localhost:5432/grasp_mvp?schema=public"

# LLM（方式一，推荐）：LLM_PROVIDER 风格。可选 deepseek / kimi / qwen / openai / zhipu / baichuan / agnes / custom
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY="sk-..."
# DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"   # 可省，用预设
# DEEPSEEK_CHAT_MODEL="deepseek-chat"               # 可省，用预设
# Embedding 专用 Provider（当前系统暂无 Embedding 场景，保留备用）
# LLM_EMBEDDING_PROVIDER=qwen

# LLM（方式二，兼容）：传统直写
# LLM_API_KEY="sk-..."
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_MODEL="gpt-4o-mini"

# 两种方式都不配置时，全部 LLM 任务走内置 Mock（离线可跑通完整流程）。
# 可按任务覆盖模型：LLM_MODEL_ACTOR / LLM_MODEL_JUDGE / LLM_MODEL_EXTRACTOR / LLM_MODEL_JUDGE_SECONDARY
# 第二评委（防自评偏差）可用独立渠道：LLM_SECONDARY_API_KEY / LLM_SECONDARY_BASE_URL
# 视频评审（对练录像帧 → 表情/眼神/口型评价）需视觉模型，如 qwen-vl-plus；不配置则回退主模型，非视觉模型时该维度自动跳过
# LLM_MODEL_VIDEO_JUDGE="qwen-vl-plus"

# LLM 请求超时（毫秒，默认 60000）：网络异常时防止 fetch 永久挂起
# LLM_TIMEOUT_MS=60000

# 对练录像存储目录（MVP 落本地磁盘，生产建议换对象存储）
# VIDEO_STORAGE_DIR="./data/videos"

# 鉴权签名密钥（生产必改）
AUTH_SECRET="grasp-dev-secret"

# 语音对练（ASR/TTS）：不配 SPEECH_PROVIDER 或配置但未给 key 时走内置 Mock（离线可跑通语音链路）
# mock | aliyun；aliyun = 阿里百炼 DashScope：ASR 用 paraformer 实时识别、TTS 用 CosyVoice（均走 WebSocket 双工协议）
SPEECH_PROVIDER=aliyun
SPEECH_API_KEY=""                 # 填入阿里百炼 DashScope API Key（也可用 DASHSCOPE_API_KEY）；留空则走 Mock
SPEECH_ASR_MODEL="paraformer-realtime-v2"
SPEECH_TTS_MODEL="cosyvoice-v2"
SPEECH_TTS_VOICE="longxiaochun_v2"
# SPEECH_WS_URL="wss://dashscope.aliyuncs.com/api-ws/v1/inference"  # 可省；新加坡/专属域名时覆盖

# 运行环境：production 时默认不灌演示考核历史（见 SEED_DEMO_HISTORY）
# NODE_ENV=development

# 演示考核历史（看板合成演示数据）：1=强制灌入；0=禁止；缺省=非 production 灌入、production 不灌
# SEED_DEMO_HISTORY=1

# 短信验证码（手机号登录）：腾讯云 SMS。未配置且 SMS_DEV_ECHO≠1 时，/auth/send-code 返回 503
# TENCENT_CLOUD_SECRET_ID=""
# TENCENT_CLOUD_SECRET_KEY=""
# TENCENT_SMS_SDK_APP_ID=""
# SMS_SIGN_NAME=""           # 短信签名
# SMS_TEMPLATE_CODE=""       # 短信模板 ID
# 开发回显：=1 时跳过真实发送，直接在响应里回 _devCode（前端自动填充登录）。仅开发用，严禁生产开启
# SMS_DEV_ECHO=1

# LiveKit 实时语音通话（三期，可选）：未配置 LIVEKIT_URL 时 /sessions/:id/livekit-ticket 返回 503
# LIVEKIT_URL="wss://your-livekit-host"
# LIVEKIT_API_KEY="devkey"
# LIVEKIT_API_SECRET="secret"
# LIVEKIT_AGENT_NAME="grasp-agent"
