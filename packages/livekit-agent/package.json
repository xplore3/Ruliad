{
  "name": "@grasp-mvp/livekit-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "grasp-agent": "./dist/worker.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "start": "node --env-file-if-exists=.env dist/worker.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@grasp-mvp/core": "workspace:*",
    "@grasp-mvp/infra": "workspace:*",
    "@grasp-mvp/llm-gateway": "workspace:*",
    "@grasp-mvp/role-engine": "workspace:*",
    "@grasp-mvp/speech-gateway": "workspace:*",
    "livekit-client": "^2.8.0",
    "livekit-server-sdk": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
